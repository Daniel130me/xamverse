// Custom engine commands are registered by the Rust invoke handler. This
// capability grants only Tauri's minimum core window surface; no filesystem,
// shell, HTTP, process, or other plugin capability is exposed to JavaScript.
{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "XamVerse desktop engine window capability",
  "windows": ["main"],
  "permissions": ["core:default"]
}
