{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XamVerse",
  "version": "0.1.0",
  "identifier": "com.xamverse.shell",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "scaffold-dist"
  },
  "app": {
    "windows": [
      {
        "title": "XamVerse",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 http://127.0.0.1:47811 ws://localhost:3000; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": []
  }
}
